# Copy to .env.local for local development. NEXT_PUBLIC_* values are bundled into the static site.

# Where booking requests are delivered. A static site has no server, so use a form backend
# (Formspree, Basin, Getform … — POST JSON) and paste its endpoint here.
# Leave empty and the booking opens a pre-filled email to NEXT_PUBLIC_CONTACT_EMAIL instead.
NEXT_PUBLIC_BOOKING_ENDPOINT=
NEXT_PUBLIC_CONTACT_EMAIL=rahnamoonhayatullah@gmail.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
